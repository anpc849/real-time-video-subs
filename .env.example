# =====================================================================
# Real-time Video Dubbing (rtsubs) - Environment Configuration
# =====================================================================
# Copy this file to .env and fill in your own settings:
#   cp .env.example .env

# LLM Translation API (OpenRouter or OpenAI-compatible endpoint)
TRANSLATION_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_api_key_here
TRANSLATION_MODEL=google/gemma-4-31b-it

# Path to Python executable for VieNeu-TTS (if running in a separate conda environment)
# Default on Windows: %USERPROFILE%/miniconda3/envs/vieneu-tts/python.exe
# VIENEU_PYTHON=C:/Users/your_username/miniconda3/envs/vieneu-tts/python.exe
